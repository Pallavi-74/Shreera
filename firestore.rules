rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && request.auth.token.email in ['REPLACE_WITH_ADMIN_EMAIL'];
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }
    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }
    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow update: if admin();
      allow delete: if false;
    }
  }
}
