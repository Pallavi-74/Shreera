import React, { useState } from 'react';
import { useApp } from '../../context/AppContext';
import { CheckCircle2, CreditCard, Banknote, ShieldCheck, Smartphone, X } from 'lucide-react';
import { UserAddress } from '../../types';

interface PaymentModalProps {
  isOpen: boolean;
  onClose: () => void;
  selectedAddress: UserAddress;
}

export const PaymentModal: React.FC<PaymentModalProps> = ({ isOpen, onClose, selectedAddress }) => {
  const { placeOrder } = useApp();
  const [selectedMethod, setSelectedMethod] = useState<string>('Cash on Delivery');
  const [isProcessing, setIsProcessing] = useState<boolean>(false);

  if (!isOpen) return null;

  const paymentOptions = [
    {
      id: 'cod',
      name: 'Cash on Delivery (COD)',
      desc: 'Pay securely with cash upon delivery.',
      icon: <Banknote className="w-5 h-5 text-blue-600" />,
    },
    {
      id: 'upi',
      name: 'UPI (Google Pay / PhonePe / Paytm)',
      desc: 'Instant dummy UPI transfer simulation.',
      icon: <Smartphone className="w-5 h-5 text-blue-600" />,
    },
    {
      id: 'card',
      name: 'Credit / Debit Card',
      desc: 'Visa, MasterCard, Rupay (Sandbox Test)',
      icon: <CreditCard className="w-5 h-5 text-blue-600" />,
    },
    {
      id: 'netbanking',
      name: 'Net Banking',
      desc: 'All major Indian banks supported.',
      icon: <ShieldCheck className="w-5 h-5 text-blue-600" />,
    },
  ];

  const handleConfirmPayment = () => {
    setIsProcessing(true);
    setTimeout(() => {
      // Calls your existing placeOrder function from AppContext
      placeOrder(selectedMethod, selectedAddress);
      setIsProcessing(false);
      onClose();
    }, 1500); // 1.5s loader simulation
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/60 backdrop-blur-xs p-4">
      <div className="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl space-y-5 animate-in fade-in zoom-in-95 duration-200">
        
        {/* Header */}
        <div className="flex items-center justify-between border-b border-slate-100 pb-3">
          <h3 className="font-serif text-lg font-bold text-slate-900">
            Select Payment Method
          </h3>
          <button onClick={onClose} className="text-slate-400 hover:text-slate-600 cursor-pointer">
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Options List */}
        <div className="space-y-3">
          {paymentOptions.map((opt) => {
            const isSelected = selectedMethod === opt.name;
            return (
              <div
                key={opt.id}
                onClick={() => setSelectedMethod(opt.name)}
                className={`flex items-start gap-3 p-3.5 rounded-xl border-2 cursor-pointer transition-all ${
                  isSelected
                    ? 'border-blue-600 bg-blue-50/40 shadow-xs'
                    : 'border-slate-200 hover:border-slate-300 bg-white'
                }`}
              >
                <div className="mt-0.5 p-2 rounded-lg bg-white shadow-2xs">
                  {opt.icon}
                </div>
                <div className="flex-1">
                  <div className="flex items-center justify-between">
                    <h4 className="text-xs font-bold text-slate-900">{opt.name}</h4>
                    {isSelected && <CheckCircle2 className="w-4 h-4 text-blue-600" />}
                  </div>
                  <p className="text-[11px] text-slate-500 mt-0.5">{opt.desc}</p>
                </div>
              </div>
            );
          })}
        </div>

        {/* Action Button */}
        <button
          onClick={handleConfirmPayment}
          disabled={isProcessing}
          className="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-md transition-all cursor-pointer flex items-center justify-center gap-2"
        >
          {isProcessing ? (
            <span>Processing Secure Dummy Payment...</span>
          ) : (
            <span>Confirm & Place Order</span>
          )}
        </button>

      </div>
    </div>
  );
};