rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && request.auth.token.email in ['REPLACE_WITH_ADMIN_EMAIL'];
    }
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if admin() && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
